{
  "mcpServers": {
    "context-mode": {
      "command": "context-mode"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "buildkite": {
      "url": "https://mcp.buildkite.com/mcp/readonly"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.6.0",
        "--browser-url=http://127.0.0.1:9333"
      ],
      "disabled": true
    }
  }
}
