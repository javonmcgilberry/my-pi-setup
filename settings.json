{
  "lastChangelogVersion": "0.84.0",
  "httpIdleTimeoutMs": 0,
  "transport": "sse",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-mono-figma",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-intercom",
    "npm:pi-anthropic-oauth",
    "npm:pi-cursor-sdk",
    "npm:@howaboua/pi-codex-conversion",
    "npm:@howaboua/pi-auto-trees",
    "npm:@howaboua/pi-smart-btw",
    "npm:pi-lens",
    "npm:pi-agent-browser-native",
    "npm:pi-autoname",
    "git:github.com/EveryInc/compound-engineering-plugin",
    "npm:pi-ask-user",
    "git:github.com/javonmcgilberry/pi-prewalk",
    "git:git@github.com:javonmcgilberry/javon-pi-extensions.git",
    "git:git@github.com:javonmcgilberry/webflow-designer-agent-browser.git",
    "npm:@vanillagreen/pi-tool-renderer",
    "npm:pi-render-cache",
    "npm:@vanillagreen/pi-extension-manager",
    "npm:pi-model-control",
    "npm:@kliebhan/pi-prompt-autocomplete",
    "npm:@davecodes/pi-skill-tags",
    "npm:pi-fzf",
    "npm:@juicesharp/rpiv-warp"
  ],
  "enabledModels": [
    "openai-codex/gpt-5.6-luna"
  ],
  "defaultThinkingLevel": "max",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "provider": {
      "maxRetries": 0
    }
  },
  "subagents": {
    "agentOverrides": {
      "worker": {
        "defaultContext": "fork",
        "acceptanceRole": "writer",
        "thinking": "high",
        "tools": "inherit"
      },
      "reviewer": {
        "defaultContext": "fresh",
        "acceptanceRole": "read-only",
        "thinking": "high",
        "tools": "inherit"
      },
      "delegate": {
        "thinking": "medium",
        "tools": "inherit"
      },
      "oracle": {
        "thinking": "max",
        "tools": "inherit"
      },
      "researcher": {
        "thinking": "medium",
        "tools": "inherit"
      },
      "scout": {
        "thinking": "low",
        "tools": "inherit"
      }
    },
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "medium"
  },
  "showCacheMissNotices": true,
  "vstack": {
    "extensionManager": {
      "config": {
        "@vanillagreen/pi-tool-renderer": {
          "readOutputMode": "summary",
          "searchOutputMode": "count",
          "bashOutputMode": "opencode",
          "mcpOutputMode": "summary"
        }
      }
    }
  }
}
