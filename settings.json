{
  "lastChangelogVersion": "0.84.0",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "packages": [
    "npm:pi-mcp-adapter@2.21.0",
    "npm:pi-web-access@0.18.0",
    "git:github.com/javonmcgilberry/context-mode@19b8f73e757eda6b71502f3e64ca5eecd1bfc7c0",
    "npm:pi-subagents@0.42.1",
    "npm:pi-intercom@0.9.2",
    "npm:pi-anthropic-oauth@0.2.4",
    "npm:pi-cursor-sdk@0.2.0",
    "npm:@howaboua/pi-codex-conversion@3.0.10",
    "npm:@howaboua/pi-auto-trees@0.1.12",
    "npm:@howaboua/pi-smart-btw@0.2.6",
    "npm:pi-lens@3.8.74",
    "npm:pi-agent-browser-native@0.3.0",
    "npm:pi-autoname@0.6.8",
    "git:github.com/EveryInc/compound-engineering-plugin@87531aeeccc8fc686f2b4bf1447d3ea3caf58ef3",
    "npm:pi-ask-user@0.14.0",
    "git:github.com/javonmcgilberry/pi-prewalk@ea1d8df39249502b3ca68ea89316d9533b8861e4",
    "npm:@vanillagreen/pi-tool-renderer@1.7.1",
    "npm:pi-render-cache@1.1.1",
    "npm:@vanillagreen/pi-extension-manager@1.3.2",
    "npm:@kliebhan/pi-prompt-autocomplete@0.2.5",
    "npm:@davecodes/pi-skill-tags@0.2.0",
    "npm:pi-fzf@0.9.0",
    "npm:@juicesharp/rpiv-warp@2.4.0"
  ],
  "enabledModels": [
    "openai-codex/gpt-5.6-luna"
  ],
  "defaultThinkingLevel": "max",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true
  },
  "subagents": {
    "agentOverrides": {
      "worker": {
        "defaultContext": "fork",
        "acceptanceRole": "writer"
      },
      "reviewer": {
        "defaultContext": "fresh",
        "acceptanceRole": "read-only"
      }
    },
    "defaultModel": "openai-codex/gpt-5.6-luna:max"
  },
  "showCacheMissNotices": true,
  "vstack": {
    "extensionManager": {
      "config": {
        "@vanillagreen/pi-tool-renderer": {
          "readOutputMode": "summary",
          "searchOutputMode": "count",
          "bashOutputMode": "opencode",
          "mcpOutputMode": "summary"
        }
      }
    }
  }
}
