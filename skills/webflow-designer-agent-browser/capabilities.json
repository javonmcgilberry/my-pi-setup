{
  "version": 1,
  "capabilities": [
    {
      "id": "browser.runtime",
      "category": "runtime",
      "implementation": "scripts/browser-runtime.py",
      "owner": "browser-runtime",
      "purpose": "Own the dedicated authenticated profile, Chrome for Testing process, direct-CDP readiness, bounded watchdog, and consumer lease.",
      "inputs": [
        "runtime-command",
        "loopback-port",
        "headless-or-headed-mode",
        "maximum-runtime"
      ],
      "postconditions": [
        "explicit-runtime-status",
        "verified-release-and-stop"
      ],
      "sensitivity": "profile-metadata",
      "maturity": "provisional",
      "disposition": "keep",
      "loadWhen": "starting, releasing, stopping, or diagnosing the authenticated browser runtime"
    },
    {
      "id": "browser.cookie-transfer",
      "category": "runtime",
      "implementation": "scripts/cookie-transfer.mjs",
      "owner": "cookie-transfer",
      "purpose": "Explicitly transfer only allowlisted, unexpired Chrome cookies into the dedicated runtime through loopback CDP.",
      "inputs": [
        "private-policy-override",
        "source-cookie-database",
        "loopback-cdp-endpoint",
        "explicit-confirmation"
      ],
      "postconditions": [
        "count-only-transfer-result",
        "source-profile-untouched",
        "temporary-snapshot-removed"
      ],
      "sensitivity": "credentials",
      "maturity": "provisional",
      "disposition": "keep",
      "loadWhen": "an authenticated run explicitly opts into cookie transfer"
    },
    {
      "id": "designer.session",
      "category": "designer",
      "implementation": "scripts/designer-session.py",
      "owner": "designer-session",
      "purpose": "Preflight declared services and emit bounded native-tool or CLI browser actions with mandatory cleanup.",
      "inputs": ["transport", "session-mode", "readiness-surface"],
      "postconditions": ["bounded-session-plan", "explicit-cleanup-plan"],
      "sensitivity": "sanitized-url-metadata",
      "maturity": "stable",
      "disposition": "keep",
      "loadWhen": "bootstrapping a bounded Designer observation"
    },
    {
      "id": "designer.readiness-gate",
      "category": "designer",
      "implementation": "scripts/readiness-gate.py",
      "owner": "readiness-subagent",
      "purpose": "Block QA execution until HUD, Designer service, target response, authenticated browser profile, rendered Designer surface, and runtime cleanup are all proven.",
      "inputs": ["bounded-readiness-checks", "runtime-cleanup-state"],
      "postconditions": [
        "machine-readable-qa-launch-decision",
        "named-blockers"
      ],
      "sensitivity": "sanitized-status-only",
      "maturity": "provisional",
      "disposition": "keep",
      "loadWhen": "before launching a Designer QA executor"
    },
    {
      "id": "designer.tabs",
      "category": "designer",
      "implementation": "scripts/discover-designer-tabs.py",
      "owner": "designer-targeting",
      "purpose": "Discover sanitized Designer targets and verify attachment ownership and surface identity.",
      "inputs": ["direct-cdp-endpoint", "sanitized-target"],
      "postconditions": ["verified-attachment-plan"],
      "sensitivity": "sanitized-url-metadata",
      "maturity": "stable",
      "disposition": "keep",
      "loadWhen": "selecting or verifying an attached Designer tab"
    },
    {
      "id": "evidence.sanitize",
      "category": "evidence",
      "implementation": "scripts/sanitize-evidence.py",
      "owner": "automation-evidence",
      "purpose": "Redact and bound browser evidence before reporting or persistence.",
      "inputs": ["browser-result"],
      "postconditions": ["sanitized-evidence"],
      "sensitivity": "secret-bearing-input",
      "maturity": "stable",
      "disposition": "keep",
      "loadWhen": "browser evidence may leave the active tool result"
    },
    {
      "id": "evidence.review",
      "category": "evidence",
      "implementation": "scripts/automation-evidence.py",
      "owner": "automation-evidence",
      "purpose": "Review complete runs and queue non-sensitive repeated automation candidates for reviewed promotion.",
      "inputs": ["sanitized-run", "sanitized-candidate"],
      "postconditions": ["review-decision", "bounded-evidence-queue"],
      "sensitivity": "non-sensitive-only",
      "maturity": "provisional",
      "disposition": "keep",
      "loadWhen": "closing a run or reviewing automation promotion candidates"
    },
    {
      "id": "designer.frame-observe",
      "category": "exceptional",
      "implementation": "scripts/cdp-frame-eval.mjs",
      "owner": "designer-frame-observation",
      "purpose": "Perform bounded file-backed observation in a matching out-of-process frame.",
      "inputs": ["frame-match", "file-backed-expression"],
      "postconditions": ["sanitized-frame-observation"],
      "sensitivity": "page-content",
      "maturity": "exceptional",
      "disposition": "keep",
      "loadWhen": "the selected browser transport cannot retain the required frame context"
    },
    {
      "id": "connected-app.authorization",
      "category": "connected-app",
      "implementation": "scripts/guarded-site-authorization.py",
      "owner": "connected-app-authorization",
      "purpose": "Validate exact-site selection and authorization postconditions from sanitized surfaces.",
      "inputs": ["sanitized-authorization-surface"],
      "postconditions": ["exact-site-authorization-proof"],
      "sensitivity": "site-identity",
      "maturity": "stable",
      "disposition": "keep",
      "loadWhen": "authorizing a supported connected application"
    },
    {
      "id": "workspace.build-verify",
      "category": "verification",
      "implementation": "scripts/verify-workspace-build.py",
      "owner": "workspace-verification",
      "purpose": "Verify generated workspace output is current before published runtime QA.",
      "inputs": ["source-module", "generated-module"],
      "postconditions": ["workspace-build-current"],
      "sensitivity": "none",
      "maturity": "stable",
      "disposition": "keep",
      "loadWhen": "a local provider depends on ignored generated output"
    },
    {
      "id": "published-site.preflight",
      "category": "verification",
      "implementation": "scripts/published-site-preflight.py",
      "owner": "published-site-verification",
      "purpose": "Classify published-site renderer readiness without leaking credentials.",
      "inputs": ["published-site-url"],
      "postconditions": ["renderer-readiness-classification"],
      "sensitivity": "sanitized-url-metadata",
      "maturity": "stable",
      "disposition": "keep",
      "loadWhen": "testing a published site that depends on a renderer"
    }
  ]
}
