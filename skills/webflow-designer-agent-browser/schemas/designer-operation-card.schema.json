{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/webflow-designer/designer-operation-card.schema.json",
  "title": "Designer operation card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "symbol", "intent", "selectionStatus", "reasonCodes",
    "capabilities", "contexts", "parameters", "document", "selectors",
    "actions", "postconditions", "guardrails", "scores", "provenance",
    "evidence", "holdoutEvidence", "negativeEvidence"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "symbol": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"},
    "intent": {"type": "string", "minLength": 1, "maxLength": 240},
    "selectionStatus": {"enum": ["include", "candidate", "negative_evidence", "holdout", "exclude"]},
    "reasonCodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "contexts": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "parameters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "document": {"enum": ["main", "canvas", "frame"]},
    "selectors": {"type": "array", "items": {"type": "object"}},
    "actions": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "guardrails": {"type": "array", "items": {"type": "string"}},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "utility", "novelty"],
      "properties": {
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
        "utility": {"type": "integer", "minimum": 0, "maximum": 100},
        "novelty": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "provenance": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "holdoutEvidence": {"type": "array", "items": {"type": "object"}},
    "negativeEvidence": {"type": "array", "items": {"type": "object"}}
  }
}
