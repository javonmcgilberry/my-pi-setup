{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/webflow-designer/designer-validation-contract.schema.json",
  "title": "Webflow Designer candidate validation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "id", "mode", "surfaceAdapter", "source", "evidenceRefs",
    "riskClass", "determinism", "runnerId", "inputs", "constraints",
    "target", "preconditions", "facts", "actions", "oracle", "recovery",
    "cleanup", "budget", "receipt"
  ],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"},
    "mode": {"const": "candidate"},
    "surfaceAdapter": {"const": "webflow-designer"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "changeSetDigest"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "changeSetDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{2,239}$"}
    },
    "riskClass": {"enum": ["read-only", "reversible-ui"]},
    "determinism": {"const": "bounded"},
    "runnerId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"},
    "inputs": {"type": "object", "maxProperties": 8},
    "constraints": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "maxLength": 160}},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "document"],
      "properties": {
        "fixture": {"const": "isolated-designer-test"},
        "document": {"enum": ["main", "canvas", "frame"]}
      }
    },
    "preconditions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "maxLength": 160}},
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
          "type": {"enum": ["boolean", "string", "count"]},
          "source": {"enum": ["trusted-operation", "playwright-assertion"]}
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "op", "dependsOn"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
          "op": {"enum": ["invoke_operation", "assert", "compensate"]},
          "dependsOn": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"type": "string"}},
          "operationId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "fact": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
          "expected": {"type": ["boolean", "string", "integer"]},
          "selectorKey": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]+$"},
          "maximumAttempts": {"type": "integer", "minimum": 1, "maximum": 2}
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fact", "expected"],
      "properties": {
        "kind": {"const": "semantic-fact"},
        "fact": {"type": "string"},
        "expected": {"type": ["boolean", "string", "integer"]}
      }
    },
    "recovery": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 160}},
    "cleanup": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "maxLength": 160}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutSeconds", "maxRetries", "maxActions"],
      "properties": {
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "maxRetries": {"type": "integer", "minimum": 0, "maximum": 1},
        "maxActions": {"type": "integer", "minimum": 2, "maximum": 8}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireSemanticOracle", "requireCleanupProof"],
      "properties": {
        "requireSemanticOracle": {"const": true},
        "requireCleanupProof": {"const": true}
      }
    }
  }
}
