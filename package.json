{
  "name": "@javonmcgilberry/pi-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Javon's personal Pi extensions and setup resources",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "agent-browser-policy.json",
    "extensions/agent-browser-policy.ts",
    "extensions/herdr-agent-state.ts",
    "extensions/pretty-footer.ts",
    "extensions/pretty-footer-view.ts",
    "packages/context-budget/context-budget.mjs",
    "packages/context-budget/index.ts",
    "packages/context-budget/package.json",
    "extensions/session-spend-dashboard/*.ts",
    "extensions/session-spend-dashboard/README.md",
    "extensions/session-spend-dashboard/package.json",
    "scripts/session-metadata-backfill.mjs",
    "extensions/warp-session-title.ts"
